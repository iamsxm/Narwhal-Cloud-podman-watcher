# ==========================================
# Narwhal Monitor Server - Environment Config
# ==========================================

# 通信共享密钥 (必须与所有 Client Agent 保持一致)
SHARED_SECRET=your-secure-random-token-here

# Web 控制台登录凭据 (HTTP Basic Auth)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=your-dashboard-password

# 容器对外暴露的 HTTP 端口 (默认 8080)
SERVER_PORT=8080

# 数据库存储路径 (容器内部路径，默认 /data/monitor.db)
DB_PATH=/data/monitor.db

# 告警阈值配置 (按需调整)
ALERT_DISK_THRESHOLD_PERCENT=80
ALERT_CPU_THRESHOLD_PERCENT=80
ALERT_CONN_WARNING_THRESHOLD=500
ALERT_CONN_CRITICAL_THRESHOLD=1000

# 连续超限自动停机阈值 (连接数 > 1500 持续 15 分钟)
CONNECTION_STOP_THRESHOLD=1500
CONNECTION_STOP_DURATION_SECONDS=900

# 离线主机清理/隐藏时间 (秒)
OFFLINE_HIDE_SECONDS=86400
OFFLINE_HOST_PURGE_SECONDS=86400

# 告警 Webhook 推送地址与级别 (留空不推送，可选 warning / critical / info)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_MIN_SEVERITY=warning
